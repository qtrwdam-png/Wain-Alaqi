# Database — PostgreSQL connection string
# Example: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/wain_alaqi?sslmode=require

# Auth
AUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=al-ramtha

# Maps
MAP_PROVIDER=leaflet

# Storage (local for dev; can be s3 / r2 / supabase later)
STORAGE_PROVIDER=local

# Optional: seed admin override (defaults to admin@example.com / ChangeMe123!)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
