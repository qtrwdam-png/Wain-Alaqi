// Wain Alaqi — Prisma schema
// Supported databases: PostgreSQL (Neon / local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// City — المدينة (قابل للتوسع مستقبلاً)
// ---------------------------------------------------------------------------
model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String   @default("الأردن")
  latitude  Float
  longitude Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores        Store[]
  districts     District[]
  searchQueries SearchQuery[]

  @@map("cities")
}

// ---------------------------------------------------------------------------
// District — الحي / المحافظة داخل مدينة
// ---------------------------------------------------------------------------
model District {
  id        String   @id @default(cuid())
  name      String
  slug      String
  cityId    String   @map("city_id")
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores Store[]

  @@unique([cityId, slug])
  @@map("districts")
}

// ---------------------------------------------------------------------------
// User — المستخدم
// ---------------------------------------------------------------------------
enum Role {
  USER
  STORE_OWNER
  ADMIN
  CONTENT_MANAGER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  active       Boolean  @default(true)
  isDemo       Boolean  @default(false) @map("is_demo")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stores        Store[]
  reviews       Review[]
  searchRequests SearchRequest[]
  searchQueries  SearchQuery[]
  reports       Report[]
  notifications Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Category — القطاع
// ---------------------------------------------------------------------------
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stores   Store[]
  products Product[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Store — المتجر
// ---------------------------------------------------------------------------
enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

model Store {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String?
  categoryId      String      @map("category_id")
  category        Category    @relation(fields: [categoryId], references: [id])
  ownerId         String      @map("owner_id")
  owner           User        @relation(fields: [ownerId], references: [id])
  cityId          String      @map("city_id")
  city            City        @relation(fields: [cityId], references: [id])
  districtId      String?     @map("district_id")
  district        District?   @relation(fields: [districtId], references: [id])
  phone           String?
  whatsapp        String?
  address         String?
  latitude        Float?
  longitude       Float?
  logo            String?
  coverImage      String?     @map("cover_image")
  openingHours    Json?       @map("opening_hours")
  status          StoreStatus @default(PENDING_REVIEW)
  verified        Boolean     @default(false)
  rejectionReason String?     @map("rejection_reason")
  isDemo          Boolean     @default(false) @map("is_demo")
  isFeatured      Boolean     @default(false) @map("is_featured")
  rating          Float       @default(0)
  reviewCount     Int         @default(0) @map("review_count")
  views           Int         @default(0)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  products  Product[]
  reviews   Review[]

  @@index([cityId])
  @@index([categoryId])
  @@index([status])
  @@map("stores")
}

// ---------------------------------------------------------------------------
// Product — المنتج
// ---------------------------------------------------------------------------
enum Availability {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

model Product {
  id             String       @id @default(cuid())
  storeId        String       @map("store_id")
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId     String?      @map("category_id")
  category       Category?    @relation(fields: [categoryId], references: [id])
  name           String
  slug           String
  description     String?
  price          Float?
  currency       String       @default("JOD")
  availability   Availability @default(UNKNOWN)
  image          String?
  active         Boolean      @default(true)
  isDemo         Boolean       @default(false) @map("is_demo")
  lastStockUpdate DateTime    @default(now()) @map("last_stock_update")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([availability])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Review — التقييم
// ---------------------------------------------------------------------------
enum ReviewStatus {
  VISIBLE
  HIDDEN
  PENDING
}

model Review {
  id        String       @id @default(cuid())
  storeId   String       @map("store_id")
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  status    ReviewStatus @default(VISIBLE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  reports Report[]

  @@unique([storeId, userId])
  @@index([userId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Report — البلاغات
// ---------------------------------------------------------------------------
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String       @map("reporter_id")
  reporter    User         @relation(fields: [reporterId], references: [id])
  reviewId    String?      @map("review_id")
  review      Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reason      String
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("reports")
}

// ---------------------------------------------------------------------------
// SearchQuery — عمليات البحث (للإحصائيات و Popular Searches)
// ---------------------------------------------------------------------------
model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  cityId    String?  @map("city_id")
  city      City?    @relation(fields: [cityId], references: [id])
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  results   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([query])
  @@map("search_queries")
}

// Trending keywords surfaced on the homepage "الأكثر بحثاً" section.
// A small set of fixed keywords is always shown (isPinned=true). Dynamic
// keywords are promoted from real user searches and auto-expire when nobody
// searches for them for 3 consecutive days (lastSearchedAt older than 3 days).
model PopularKeyword {
  id             String   @id @default(cuid())
  keyword        String   @unique
  isPinned       Boolean  @default(false) @map("is_pinned")
  // how many times this keyword has been searched (for ordering "most popular")
  searchCount    Int      @default(0) @map("search_count")
  lastSearchedAt DateTime @default(now()) @map("last_searched_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPinned])
  @@index([lastSearchedAt])
  @@map("popular_keywords")
}

// ---------------------------------------------------------------------------
// SearchRequest — طلبات "لم أجد ما أبحث عنه"
// ---------------------------------------------------------------------------
enum SearchRequestStatus {
  NEW
  SEARCHING
  FOUND
  CLOSED
}

model SearchRequest {
  id        String             @id @default(cuid())
  query     String
  notes     String?
  phone     String?
  email     String?
  userId    String?            @map("user_id")
  user      User?              @relation(fields: [userId], references: [id])
  status    SearchRequestStatus @default(NEW)
  count     Int                @default(1)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([query])
  @@index([status])
  @@index([userId])
  @@map("search_requests")
}

// ---------------------------------------------------------------------------
// Content — محتوى الصفحات (قابل للتعديل من CMS)
// ---------------------------------------------------------------------------
model Content {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content")
}

// ---------------------------------------------------------------------------
// AuditLog — سجل العمليات الإدارية
// ---------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Notification — إشعارات للمستخدمين (موافقة/رفض المتجر وغيرها)
// ---------------------------------------------------------------------------
enum NotificationType {
  STORE_APPROVED
  STORE_REJECTED
  STORE_SUSPENDED
  STORE_RESTORED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, read])
  @@map("notifications")
}
